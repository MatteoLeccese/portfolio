{
  "name": "portfolio",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev --port 3200",
    "build": "next build",
    "start": "next start --port 3200",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:style": "tsx scripts/check-style-rules.ts",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "check": "npm run typecheck && npm run lint && npm run check:style && npm run check:contrast && npm run test",
    "icons:skills": "tsx scripts/generate-skill-icons.ts",
    "icons:brand": "tsx scripts/generate-brand-icons.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.44.0",
    "motion": "13.2.0",
    "next": "16.3.4",
    "next-intl": "4.14.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.27.0",
    "server-only": "0.0.1",
    "shadcn": "4.21.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-boundaries": "7.2.0",
    "png-to-ico": "3.0.2",
    "schema-dts": "2.0.0",
    "sharp": "0.35.4",
    "simple-icons": "16.30.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.0"
  }
}
