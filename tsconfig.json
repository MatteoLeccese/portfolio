{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [ "dom", "dom.iterable", "esnext" ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",

    "allowJs": false,
    "jsx": "react-jsx",
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // ── Strictness ───────────────────────────────────────────────────────────
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // Indexed access on arrays and records yields `T | undefined`.
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "plugins": [ { "name": "next" } ],
    "paths": { "@/*": [ "./src/*" ] }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [ "node_modules", ".baseline" ]
}
