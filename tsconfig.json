{
  "compilerOptions": {
    // ES2022 instead of the ES2017 inherited from create-next-app: Node 22+ and every target
    // browser support it, and it enables `.at()`, top-level await and class fields.
    "target": "ES2022",
    "lib": [ "dom", "dom.iterable", "esnext" ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",

    // The project is 100% TypeScript. `allowJs: false` keeps an untyped .js file from sneaking in.
    "allowJs": false,
    "jsx": "react-jsx",
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // ── Strictness ───────────────────────────────────────────────────────────
    "strict": true,
    // The three flags code-style.md requires on top of `strict`:
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // Extra: array[i] becomes `T | undefined`. Verified NOT to affect Record<Locale, string>.
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "plugins": [ { "name": "next" } ],
    "paths": { "@/*": [ "./src/*" ] }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [ "node_modules", ".baseline" ]
}
