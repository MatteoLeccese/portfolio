# Local development template. Copy to .env.local and fill it in.
# .env.local is git-ignored; this file is the versioned template and holds no secrets.

# ---- Public: baked into the client bundle at build time --------------------
# Every NEXT_PUBLIC_ value reaches the browser. Changing one needs a rebuild
NEXT_PUBLIC_SITE_URL=http://localhost:3200

# Identity rendered on the page. Unset, each one falls back to the value in
# src/domains/core/config/site.ts, so `npm run dev` works with none of them set.
# NEXT_PUBLIC_SITE_EMAIL is the exception under `npm run build`, which runs as a
# production build and throws without it: fill it in before building locally.
# A value that is not an email address, or not an absolute http(s) URL, fails the build
# with the name of the variable and the value it refused.
NEXT_PUBLIC_SITE_EMAIL=
NEXT_PUBLIC_SITE_GITHUB_URL=
NEXT_PUBLIC_SITE_LINKEDIN_URL=

# The contact section switch. "true" renders the form and sends through Resend; unset,
# empty or anything else renders no form and links the visitor to NEXT_PUBLIC_SITE_EMAIL
# instead. Only with this set to "true" do the four Resend variables below matter.
NEXT_PUBLIC_USE_RESEND_EMAIL_FORM=true

# ---- Server: runtime only, never reaches the browser ----------------------
# The four below are read only when NEXT_PUBLIC_USE_RESEND_EMAIL_FORM=true. With the form
# off, leave all four unset: nothing reads them.
#
# Resend allows sending from onboarding@resend.dev without a verified domain,
# but only to the address the account was registered with.
# Leave RESEND_API_KEY empty to log the email to stdout instead of sending it.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Portfolio dev <onboarding@resend.dev>"
CONTACT_TO_EMAIL=dev@localhost
RATE_LIMIT_SALT=local-development-salt

# ---- Optional: leave unset locally ----------------------------------------
# TRUST_PROXY: read by contact/actions/submitContact.ts. "1" makes clientIp() trust
# x-forwarded-for. There is no proxy in front of `next dev`, so leave it unset;
# playwright.config.ts sets it to 1 for the E2E run only.
# TRUST_PROXY=

# SITE_INDEXABLE: forces the robots guard. "1" makes the build indexable, which is what a
# manual `npx lhci autorun` needs so the SEO audit does not read a noindex page.
# Unset means "indexable only when VERCEL_ENV=production", which is what you want here.
# SITE_INDEXABLE=

# Not set here, on purpose: VERCEL_ENV is injected by Vercel, and DOCKER_BUILD and
# NEXT_TELEMETRY_DISABLED are set by the Dockerfile. IMAGE_TAG and WEB_PORT are
# docker-compose interpolation only and live in .env.example.production.
