# Production template. On Vercel, paste these into the project's Environment Variables
# panel. On the Docker path, `cp .env.example.production .env` and fill it in — compose
# reads that same .env both for ${...} interpolation and for env_file.
# Never commit a filled-in copy: .gitignore excepts only .env.example.*

# ---- Public: baked into the client bundle at build time --------------------
# Every NEXT_PUBLIC_ value reaches the browser, so no secret ever carries that prefix.
# Changing any of them requires a REBUILD, not a restart: a redeploy on Vercel,
# `docker compose up -d --build` on Docker. On Docker the build reads them as build
# arguments, so they have to be in place before the image is built, not only before it
# runs.

# REQUIRED. The build throws without it.
NEXT_PUBLIC_SITE_URL=https://matteoleccese.com

# REQUIRED. The build throws without it. The address the contact section hands the
# visitor when the form is off, the {ownerEmail} the legal pages resolve, and the mail
# entry of the social links. It is rendered in plain text on the page, exactly as it is
# today: this variable moves where the value is configured, it does not hide it.
# A value that is not an email address fails the build with the value it refused.
NEXT_PUBLIC_SITE_EMAIL=

# Optional. Unset, each falls back to the URL in src/domains/core/config/site.ts, so the
# links keep working; set one to point somewhere else. Both feed the social links and the
# schema.org `sameAs` of the JSON-LD. A value that is not an absolute http(s) URL fails
# the build with the name of the variable and the value it refused.
NEXT_PUBLIC_SITE_GITHUB_URL=
NEXT_PUBLIC_SITE_LINKEDIN_URL=

# The contact section switch. Default false.
#   true  — the form renders and sends through Resend. The four Resend variables below
#           are then required.
#   unset, empty or anything else — no form. The section takes the visitor to
#           NEXT_PUBLIC_SITE_EMAIL so they write directly, and RESEND_API_KEY,
#           CONTACT_FROM_EMAIL, CONTACT_TO_EMAIL and RATE_LIMIT_SALT are all unnecessary:
#           leave those four unset and configure no secret for them.
# Only the exact string "true" turns the form on.
NEXT_PUBLIC_USE_RESEND_EMAIL_FORM=true

# ---- Server: runtime only, never reaches the browser ----------------------
# Required when NEXT_PUBLIC_USE_RESEND_EMAIL_FORM=true. Unnecessary otherwise.
# No secret ever carries the NEXT_PUBLIC_ prefix.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Matteo Leccese <contact@matteoleccese.com>"
CONTACT_TO_EMAIL=
# Required when the form is on (requireEnv, no silent default). Generate it once with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
RATE_LIMIT_SALT=

# ---- Optional -------------------------------------------------------------
# Read by contact/actions/submitContact.ts. Set to 1 ONLY when a trusted reverse proxy
# overwrites X-Forwarded-For. On Vercel leave it unset: x-vercel-forwarded-for is already
# trustworthy and is read first. Behind a bare published port, a client can forge the
# header and walk around the rate limit. Nothing reads it when the form is off.
TRUST_PROXY=

# Forces the robots guard on. On Vercel leave it UNSET: VERCEL_ENV=production already
# makes the site indexable. On the self-hosted Docker path VERCEL_ENV does not exist, so
# isIndexable() falls back to false and the site would ship noindex — set it to 1 there.
# "0" forces noindex anywhere.
SITE_INDEXABLE=

# Docker path only; ignored on Vercel. Image tag and host port for docker-compose.yml.
# IMAGE_TAG is overridden per deploy with a dated value, which is what makes rollback
# possible.
IMAGE_TAG=latest
WEB_PORT=3200

# Not set here, on purpose: VERCEL_ENV is injected by Vercel, and DOCKER_BUILD and
# NEXT_TELEMETRY_DISABLED are set by the Dockerfile.
